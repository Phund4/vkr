        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "(sum by (source, stage) (label_replace(sum by (instance, stage) (rate(router_operation_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"router\", \"instance\", \".+\")) or sum by (source, stage) (label_replace(sum by (instance, stage) (rate(analytics_process_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"analytics_process\", \"instance\", \".+\")) or sum by (source, stage) (label_replace(sum by (instance, stage) (rate(analytics_kafka_publish_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"analytics_kafka\", \"instance\", \".+\")) or sum by (source, stage) (label_replace(sum by (instance, stage) (rate(pusher_process_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"pusher_process\", \"instance\", \".+\")) or sum by (source, stage) (label_replace(sum by (instance, stage) (rate(pusher_kafka_consume_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"pusher_kafka\", \"instance\", \".+\")) or sum by (source, stage) (label_replace(label_replace(sum by (instance, op) (rate(pusher_clickhouse_errors_total{instance=~\"$instance\"}[5m])), \"stage\", \"$1\", \"op\", \"(.+)\"), \"source\", \"pusher_ch\", \"stage\", \".+\")) or sum by (source, stage) (label_replace(sum by (instance, branch, stage) (rate(ml_kafka_errors_total{instance=~\"$instance\"}[5m])), \"source\", \"ml_kafka\", \"instance\", \".+\")))",
          "legendFormat": "{{source}} {{stage}}",
          "refId": "A"
        }
      ]
    },

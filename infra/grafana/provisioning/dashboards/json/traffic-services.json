  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "title": "Results (данные конвейера)",
      "type": "link",
      "url": "/d/traffic-results?${__url_time_range}"

    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "description": "Метка source: router, analytics_ingest, analytics_kafka, pusher_*, ml. Сузить: в легенде отключите лишние серии.",
      "title": "Ошибки конвейера (все источники, одна панель)",
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {

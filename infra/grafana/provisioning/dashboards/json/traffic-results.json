{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "description": "Гейджи и скорости по данным конвейера (дорога, инциденты, запись в хранилища).",
  "links": [
    {
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "title": "Services (сервисы и метрики)",
      "type": "link",
      "url": "/d/traffic-services?${__url_time_range}"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Дорога и ML (гейджи по segment × camera)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "analytics_road_congestion_score{segment_id=~\"$segment\",camera_id=~\"$camera\"}",
          "legendFormat": "{{segment_id}} / {{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Загруженность по камерам (congestion_score)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "analytics_road_crash_alert{segment_id=~\"$segment\",camera_id=~\"$camera\"}",
          "legendFormat": "{{segment_id}} / {{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Факт ДТП по камере (1 = авария)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 201,
      "title": "Запись в хранилища",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "bars", "fillOpacity": 80 }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum by (segment_id, camera_id) (rate(analytics_road_incidents_recorded_total{segment_id=~\"$segment\",camera_id=~\"$camera\"}[15m]))",
          "legendFormat": "{{segment_id}} / {{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Инциденты → Kafka (analytics), скорость",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 } }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "targets": [
        {
          "expr": "sum by (instance, op) (rate(pusher_clickhouse_errors_total{instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{instance}} {{op}}",
          "refId": "A"
        }
      ],
      "title": "Ошибки ClickHouse (pusher, по реплике)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20 } }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "targets": [
        {
          "expr": "sum by (instance, topic) (rate(pusher_kafka_messages_processed_total{instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{instance}} {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Pusher: успешно обработанные persist-сообщения",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["traffic"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(analytics_road_congestion_score, segment_id)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Segment",
        "multi": true,
        "name": "segment",
        "options": [],
        "query": "label_values(analytics_road_congestion_score, segment_id)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(analytics_road_congestion_score{segment_id=~\"$segment\"}, camera_id)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Camera",
        "multi": true,
        "name": "camera",
        "options": [],
        "query": "label_values(analytics_road_congestion_score{segment_id=~\"$segment\"}, camera_id)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=\"pusher\"}, instance)",
        "description": "Реплики pusher (для панелей записи в CH/Kafka)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pusher instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(up{job=\"pusher\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Results (данные конвейера)",
  "uid": "traffic-results",
  "version": 5
}
